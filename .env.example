# Copy to .env. The defaults run fully offline on SQLite.

# --- Database ------------------------------------------------------------------
T2SQL_DATABASE_URL=sqlite:///data/analytics.db
# T2SQL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analytics

# --- SQL generation: offline | openai | anthropic -------------------------------
T2SQL_LLM_PROVIDER=offline
T2SQL_OPENAI_API_KEY=
T2SQL_ANTHROPIC_API_KEY=
T2SQL_OPENAI_MODEL=gpt-4o-mini
T2SQL_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Conversation memory: memory | mongo ----------------------------------------
T2SQL_MEMORY_BACKEND=memory
# T2SQL_MONGO_URI=mongodb://localhost:27017
T2SQL_HISTORY_TURNS=5

# --- Guardrails ------------------------------------------------------------------
T2SQL_MAX_ROWS=200
T2SQL_MAX_ATTEMPTS=3
T2SQL_STATEMENT_TIMEOUT_MS=5000

# --- API -------------------------------------------------------------------------
T2SQL_API_KEY=
